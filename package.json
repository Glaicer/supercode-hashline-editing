{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@glaicer/supercode-hashline-editing",
  "version": "0.1.0",
  "description": "OpenCode plugin for capability-bound hashline read/edit operations",
  "type": "module",
  "license": "MIT",
  "author": "Dmitrii Aronov <aronov.mml@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glaicer/supercode-hashline-editing.git"
  },
  "homepage": "https://github.com/Glaicer/supercode-hashline-editing#readme",
  "bugs": {
    "url": "https://github.com/Glaicer/supercode-hashline-editing/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "hashline-editing"
  ],
  "main": "./dist/hashline.js",
  "exports": {
    ".": "./dist/hashline.js",
    "./server": "./dist/hashline.js",
    "./service": "./dist/service.js",
    "./parser": "./dist/parser.js",
    "./snapshots": "./dist/snapshots.js",
    "./filesystem": "./dist/filesystem.js",
    "./hash": "./dist/hash.js",
    "./errors": "./dist/errors.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check:package",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": ">=1.18.21"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@types/node": "24.13.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=24",
    "opencode": ">=1.18.21"
  }
}
